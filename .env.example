# Copy with npm run setup (never overwrites an existing .env).
# Account email/password are requested only by npm run login; never put them here.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# Comma-separated exact numeric chat IDs. Empty means ALL rooms blocked.
KAKAO_ALLOWED_ROOMS=
# Prefix must be followed by whitespace. Only explicit !ai requests are forwarded.
KAKAO_TRIGGER_PREFIX=!ai
BRIDGE_STATE_DIR=.state
AI_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=800
BRIDGE_MAX_INPUT_CHARS=4000
BRIDGE_MAX_OUTPUT_CHARS=1800
BRIDGE_COOLDOWN_MS=5000
BRIDGE_MAX_REQUESTS_PER_HOUR=30
# HTTP is allowed only on literal localhost/127.0.0.1/[::1], never arbitrary LAN.
# Own OpenClaw: AI_BASE_URL=http://127.0.0.1:18789/v1
# AI_MODEL=openclaw/default ; AI_API_KEY=<your own gateway token>
