# npm run setup으로 .env 생성. 기존 파일은 덮어쓰지 않습니다.
# 카카오 이메일/비밀번호는 npm run login에서만 입력합니다.
# 연결 방식: openai-compatible (기본값) 또는 openclaw
AI_PROVIDER=openai-compatible

# A. OpenAI 호환 API: 제공자의 API 키와 모델 이름
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# B. 전용 OpenClaw: AI_PROVIDER=openclaw로 바꾸고 아래 값을 입력
# 제공자 OAuth 로그인/갱신은 OpenClaw 담당. OAuth 토큰을 복사하지 마세요.
# Gateway 접속 토큰은 AI API 키와 다르며 loopback에서도 필수입니다.
# 실제 전용 에이전트 ID를 입력하세요. default 별칭은 허용하지 않습니다.
OPENCLAW_BASE_URL=http://127.0.0.1:18789/v1
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_AGENT_ID=

# 실제 조회한 숫자 방 ID를 쉼표로 구분. 비어 있으면 모든 방 차단.
KAKAO_ALLOWED_ROOMS=
# auto(기본): 1:1 방은 모든 텍스트에 답하고, 단체방은 AI에게 한 말에만 답합니다.
# prefix: 모든 방에서 '!ai 질문'(접두사 뒤 공백)에만 답합니다.
KAKAO_REPLY_MODE=auto
# 첫 번째는 AI의 이름, 나머지는 부르는 말(쉼표 구분). 포함 여부로 인식하므로
# '이삭'을 넣으면 '이삭아', '이삭이'도 인식합니다. 봇 계정 닉네임은 자동 포함.
KAKAO_BOT_NAMES=
KAKAO_TRIGGER_PREFIX=!ai
BRIDGE_STATE_DIR=.state
AI_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=800
BRIDGE_MAX_INPUT_CHARS=4000
BRIDGE_MAX_OUTPUT_CHARS=1800
BRIDGE_COOLDOWN_MS=5000
BRIDGE_MAX_REQUESTS_PER_HOUR=30
BRIDGE_MAX_JUDGES_PER_HOUR=60
BRIDGE_GROUP_FOLLOWUP_MS=180000
# HTTP는 localhost/127.0.0.1/[::1]만 허용. 원격은 HTTPS 필요.
# Gateway는 전용 인스턴스+최소권한+비공개 ingress로 운영하세요.
